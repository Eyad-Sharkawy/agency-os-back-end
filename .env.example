# Copy this file to .env and fill in your values:
#   cp .env.example .env

DB_URL=jdbc:postgresql://localhost:5432/agency_os
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DRIVER=org.postgresql.Driver

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:4200

PORT=8080

KEYCLOAK_ISSUER_URI=your_issuer_uri
KEYCLOAK_FRONTEND_CLIENT_ID=your_frontend_clinet_id

# k6 Stress Testing Configuration
# Dedicated Keycloak client with Direct Access Grants enabled (best practice: agency-os-test)
KEYCLOAK_TEST_CLIENT_ID=agency-os-test
KEYCLOAK_TEST_CLIENT_SECRET=your_client_secret_here
TEST_USER_USERNAME=your_keycloak_test_username
TEST_USER_PASSWORD=your_keycloak_test_password

# List of active workspace tenant IDs to route traffic across
TENANT_IDS=tenant_test_agency_1_60aa4d,tenant_test_agency_2_71c2c6,tenant_test_agency_3_c0e45c

# Optional: manually override the token if you want to bypass auto-retrieval
JWT_TOKEN=

