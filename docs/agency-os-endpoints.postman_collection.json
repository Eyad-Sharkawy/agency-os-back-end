    {
      "name": "6. Time Tracking (Stopwatch & Logs)",
      "item": [
        {
          "name": "Log Time Manually",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskId\": \"{{taskId}}\",\n  \"durationMinutes\": 120,\n  \"isBillable\": true,\n  \"userId\": \"{{memberUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/time-entries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "time-entries"
              ]
            },
            "description": "Manually records a time entry for an assigned task. Broadcasts to /topic/{tenantId}/time-entries."
          },
          "response": []
        },
        {
          "name": "Get All Time Entries (Filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/time-entries?taskId={{taskId}}&userId={{memberUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "time-entries"
              ],
              "query": [
                {
                  "key": "taskId",
                  "value": "{{taskId}}",
                  "disabled": true
                },
                {
                  "key": "userId",
                  "value": "{{memberUserId}}",
                  "disabled": true
                }
              ]
            },
            "description": "Retrieves the list of all logged time entries in the current workspace, optionally filtered by taskId or userId."
          },
          "response": []
        },
        {
          "name": "Start Stopwatch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/time-entries/start/:taskId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "time-entries",
                "start",
                ":taskId"
              ],
              "variable": [
                {
                  "key": "taskId",
                  "value": "{{taskId}}"
                }
              ]
            },
            "description": "Starts a live stopwatch timer on an assigned task (1 active timer per user). Broadcasts to /topic/{tenantId}/timers/start."
          },
          "response": []
        },
        {
          "name": "Pause Stopwatch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/time-entries/pause",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "time-entries",
                "pause"
              ]
            },
            "description": "Pauses the currently running stopwatch timer and saves elapsed time. Broadcasts to /topic/{tenantId}/timers/pause."
          },
          "response": []
        },
        {
          "name": "Resume Stopwatch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/time-entries/resume",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "time-entries",
                "resume"
              ]
            },
            "description": "Resumes a paused stopwatch timer for the user. Broadcasts to /topic/{tenantId}/timers/resume."
          },
          "response": []
        },
        {
          "name": "Stop Stopwatch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/time-entries/stop?isBillable=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "time-entries",
                "stop"
              ],
              "query": [
                {
                  "key": "isBillable",
                  "value": "true"
                },
                {
                  "key": "durationMinutes",
                  "value": "120",
                  "disabled": true
                }
              ]
            },
            "description": "Stops the active stopwatch, saves a TimeEntry, and broadcasts to /topic/{tenantId}/timers/stop."
          },
          "response": []
        },
        {
          "name": "Get Running Active Timer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/time-entries/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "time-entries",
                "active"
              ]
            },
            "description": "Retrieves the active running stopwatch timer metadata, or returns 204 No Content if none."
          },
          "response": []
        },
        {
          "name": "Get Time Entries By Task ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/time-entries/task/:taskId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "time-entries",
                "task",
                ":taskId"
              ],
              "variable": [
                {
                  "key": "taskId",
                  "value": "{{taskId}}"
                }
              ]
            },
            "description": "Returns all logged time entries associated with a specific task."
          },
          "response": []
        },
        {
          "name": "Get Time Entries By User ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/time-entries/user/:userId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "time-entries",
                "user",
                ":userId"
              ],
              "variable": [
                {
                  "key": "userId",
                  "value": "{{memberUserId}}"
                }
              ]
            },
            "description": "Returns all logged time entries submitted by a specific user."
          },
          "response": []
        },
        {
          "name": "Delete Time Entry",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/time-entries/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "time-entries",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{timeEntryId}}"
                }
              ]
            },
            "description": "Deletes a recorded time entry."
          },
          "response": []
        }
      ]
    },
