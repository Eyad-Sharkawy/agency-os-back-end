              "raw": "{\n  \"title\": \"Design Checkout Flow & Responsive Mobile\",\n  \"description\": \"Include dark mode wireframes and Stripe modal checkout\",\n  \"startDate\": \"2026-08-15T09:00:00Z\",\n  \"dueDate\": \"2026-08-28T18:00:00Z\",\n  \"estimatedMinutes\": 600,\n  \"priority\": \"URGENT\",\n  \"status\": \"IN_PROGRESS\",\n  \"projectId\": \"{{projectId}}\",\n  \"assigneeIds\": [\n    \"{{memberUserId}}\"\n  ]\n}"
